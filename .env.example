# Public site URL used for canonical links, Open Graph and the sitemap.
# Replace [DOMAIN] before production. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=https://[DOMAIN]

# Optional. Static export has no API routes. Point the contact form at an
# external endpoint and remove app/api before `output: 'export'`.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://form-endpoint.example/contact
